# Copy this file to .env and fill in your values.

# SQLite path (relative) or any SQLAlchemy-compatible URL
DATABASE_URL=sqlite:///./certificates.db

# Absolute or relative path where generated PDF files are stored
MEDIA_ROOT=./media

# Maximum number of recipients per job submission (envelope-level 422 if exceeded)
MAX_RECIPIENTS_PER_JOB=1000

# Number of pending records loaded per worker batch
PROCESSING_BATCH_SIZE=100

# Maximum CSV upload size in bytes
CSV_MAX_BYTES=5242880

# Optional API key for job endpoints; leave blank to disable authentication
API_KEY=

# Base URL used for QR code verification links embedded in certificates
BASE_URL=http://localhost:8000
